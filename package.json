{
  "name": "liveclass-desktop",
  "productName": "LiveClass",
  "version": "1.5.1",
  "description": "LiveClass desktop app for teachers: share anything and annotate anywhere on the screen",
  "author": "SATAREA",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "koffi": "3.3.5"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "tech.satarea.liveclass",
    "productName": "LiveClass",
    "copyright": "SATAREA",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*.node",
      "node_modules/@koromix/koffi-*/**/*.node"
    ],
    "icon": "assets/icon.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "LiveClass-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LiveClass"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "files": [
        "!node_modules/koffi{,/**/*}",
        "!node_modules/@koromix{,/**/*}"
      ],
      "category": "public.app-category.education",
      "artifactName": "LiveClass-${version}.${ext}",
      "extendInfo": {
        "NSCameraUsageDescription": "LiveClass uses the camera for your video in class.",
        "NSMicrophoneUsageDescription": "LiveClass uses the microphone so students can hear you."
      }
    },
    "protocols": [
      {
        "name": "LiveClass",
        "schemes": [
          "liveclass"
        ]
      }
    ]
  }
}
